LCH4_CHNbySoil  = IGNORE;  { Tracks loss of CH4_CHN by Soil }
CH4_EAS     = IGNORE;  { Methane from EAS regional emissions }
LCH4_EASbyOH    = IGNORE;  { Tracks loss of CH4_EAS by OH }
LCH4_EASbyCl    = IGNORE;  { Tracks loss of CH4_EAS by Cl }
LCH4_EASbyO1D   = IGNORE;  { Tracks loss of CH4_EAS by O1D }
LCH4_EASbySoil  = IGNORE;  { Tracks loss of CH4_EAS by Soil }
CH4_SEA     = IGNORE;  { Methane from SEA regional emissions }
LCH4_SEAbyOH    = IGNORE;  { Tracks loss of CH4_SEA by OH }
LCH4_SEAbyCl    = IGNORE;  { Tracks loss of CH4_SEA by Cl }
LCH4_SEAbyO1D   = IGNORE;  { Tracks loss of CH4_SEA by O1D }
LCH4_SEAbySoil  = IGNORE;  { Tracks loss of CH4_SEA by Soil }
