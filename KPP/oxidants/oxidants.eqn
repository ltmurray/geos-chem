LCH4_WAFbySoil  = IGNORE;  { Tracks loss of CH4_WAF by Soil }
CH4_CAF     = IGNORE;  { Methane from CAF regional emissions }
LCH4_CAFbyOH    = IGNORE;  { Tracks loss of CH4_CAF by OH }
LCH4_CAFbyCl    = IGNORE;  { Tracks loss of CH4_CAF by Cl }
LCH4_CAFbyO1D   = IGNORE;  { Tracks loss of CH4_CAF by O1D }
LCH4_CAFbySoil  = IGNORE;  { Tracks loss of CH4_CAF by Soil }
