{ oxidants.eqn
===============================================================================
DESCRIPTION
===============================================================================

GEOS-Chem KPP file containing species and equations for the prescribed
oxidants mechanism

===============================================================================
FILE HISTORY
===============================================================================

v14.1.0 (release TBD)
---------------------
(1) Initial version (MSL)

}

#include atoms.kpp     { Periodic table information               }

#DEFVAR
CH4         = IGNORE;  { Active methane species                   }
CO          = IGNORE;  { Active carbon monoxide species           }
PCOfromCH4  = IGNORE;  { Tracks P(CO) from CH4   for diagnostics }
PCOfromNMVOC= IGNORE;  { Tracks P(CO) from NMVOC for diagnostics }
LCH4byOH    = IGNORE;  { Dummy spc to track loss of CH4 by OH     }
LCH4byCl    = IGNORE;  { Dummy spc to track loss of CH4 by Cl     }
LCH4byO1D   = IGNORE;  { Dummy spc to track loss of CH4 by O(1D)  }
LCH4bySoil  = IGNORE;  { Dummy spc to track loss of CH4 to soils  }
LCObyOH     = IGNORE;  { Dummy spc to track loss of CO  by OH     }
CH4_OIL     = IGNORE;  { Methane from OIL emissions }
LCH4_OILbyOH    = IGNORE;  { Tracks loss of CH4_OIL by OH }
LCH4_OILbyCl    = IGNORE;  { Tracks loss of CH4_OIL by Cl }
LCH4_OILbyO1D   = IGNORE;  { Tracks loss of CH4_OIL by O1D }
LCH4_OILbySoil  = IGNORE;  { Tracks loss of CH4_OIL by Soil }
CH4_GAS     = IGNORE;  { Methane from GAS emissions }
LCH4_GASbyOH    = IGNORE;  { Tracks loss of CH4_GAS by OH }
LCH4_GASbyCl    = IGNORE;  { Tracks loss of CH4_GAS by Cl }
LCH4_GASbyO1D   = IGNORE;  { Tracks loss of CH4_GAS by O1D }
LCH4_GASbySoil  = IGNORE;  { Tracks loss of CH4_GAS by Soil }
CH4_COL     = IGNORE;  { Methane from COL emissions }
LCH4_COLbyOH    = IGNORE;  { Tracks loss of CH4_COL by OH }
LCH4_COLbyCl    = IGNORE;  { Tracks loss of CH4_COL by Cl }
LCH4_COLbyO1D   = IGNORE;  { Tracks loss of CH4_COL by O1D }
LCH4_COLbySoil  = IGNORE;  { Tracks loss of CH4_COL by Soil }
CH4_LIV     = IGNORE;  { Methane from LIV emissions }
LCH4_LIVbyOH    = IGNORE;  { Tracks loss of CH4_LIV by OH }
LCH4_LIVbyCl    = IGNORE;  { Tracks loss of CH4_LIV by Cl }
LCH4_LIVbyO1D   = IGNORE;  { Tracks loss of CH4_LIV by O1D }
LCH4_LIVbySoil  = IGNORE;  { Tracks loss of CH4_LIV by Soil }
CH4_LDF     = IGNORE;  { Methane from LDF emissions }
LCH4_LDFbyOH    = IGNORE;  { Tracks loss of CH4_LDF by OH }
LCH4_LDFbyCl    = IGNORE;  { Tracks loss of CH4_LDF by Cl }
LCH4_LDFbyO1D   = IGNORE;  { Tracks loss of CH4_LDF by O1D }
LCH4_LDFbySoil  = IGNORE;  { Tracks loss of CH4_LDF by Soil }
CH4_WST     = IGNORE;  { Methane from WST emissions }
LCH4_WSTbyOH    = IGNORE;  { Tracks loss of CH4_WST by OH }
LCH4_WSTbyCl    = IGNORE;  { Tracks loss of CH4_WST by Cl }
LCH4_WSTbyO1D   = IGNORE;  { Tracks loss of CH4_WST by O1D }
LCH4_WSTbySoil  = IGNORE;  { Tracks loss of CH4_WST by Soil }
CH4_RIC     = IGNORE;  { Methane from RIC emissions }
LCH4_RICbyOH    = IGNORE;  { Tracks loss of CH4_RIC by OH }
LCH4_RICbyCl    = IGNORE;  { Tracks loss of CH4_RIC by Cl }
LCH4_RICbyO1D   = IGNORE;  { Tracks loss of CH4_RIC by O1D }
LCH4_RICbySoil  = IGNORE;  { Tracks loss of CH4_RIC by Soil }
CH4_OTA     = IGNORE;  { Methane from OTA emissions }
LCH4_OTAbyOH    = IGNORE;  { Tracks loss of CH4_OTA by OH }
LCH4_OTAbyCl    = IGNORE;  { Tracks loss of CH4_OTA by Cl }
LCH4_OTAbyO1D   = IGNORE;  { Tracks loss of CH4_OTA by O1D }
LCH4_OTAbySoil  = IGNORE;  { Tracks loss of CH4_OTA by Soil }
CH4_BBN     = IGNORE;  { Methane from BBN emissions }
LCH4_BBNbyOH    = IGNORE;  { Tracks loss of CH4_BBN by OH }
LCH4_BBNbyCl    = IGNORE;  { Tracks loss of CH4_BBN by Cl }
LCH4_BBNbyO1D   = IGNORE;  { Tracks loss of CH4_BBN by O1D }
LCH4_BBNbySoil  = IGNORE;  { Tracks loss of CH4_BBN by Soil }
CH4_WTL     = IGNORE;  { Methane from WTL emissions }
LCH4_WTLbyOH    = IGNORE;  { Tracks loss of CH4_WTL by OH }
LCH4_WTLbyCl    = IGNORE;  { Tracks loss of CH4_WTL by Cl }
LCH4_WTLbyO1D   = IGNORE;  { Tracks loss of CH4_WTL by O1D }
LCH4_WTLbySoil  = IGNORE;  { Tracks loss of CH4_WTL by Soil }
CH4_SEE     = IGNORE;  { Methane from SEE emissions }
LCH4_SEEbyOH    = IGNORE;  { Tracks loss of CH4_SEE by OH }
LCH4_SEEbyCl    = IGNORE;  { Tracks loss of CH4_SEE by Cl }
LCH4_SEEbyO1D   = IGNORE;  { Tracks loss of CH4_SEE by O1D }
LCH4_SEEbySoil  = IGNORE;  { Tracks loss of CH4_SEE by Soil }
CH4_LAK     = IGNORE;  { Methane from LAK emissions }
LCH4_LAKbyOH    = IGNORE;  { Tracks loss of CH4_LAK by OH }
LCH4_LAKbyCl    = IGNORE;  { Tracks loss of CH4_LAK by Cl }
LCH4_LAKbyO1D   = IGNORE;  { Tracks loss of CH4_LAK by O1D }
LCH4_LAKbySoil  = IGNORE;  { Tracks loss of CH4_LAK by Soil }
CH4_TER     = IGNORE;  { Methane from TER emissions }
LCH4_TERbyOH    = IGNORE;  { Tracks loss of CH4_TER by OH }
LCH4_TERbyCl    = IGNORE;  { Tracks loss of CH4_TER by Cl }
LCH4_TERbyO1D   = IGNORE;  { Tracks loss of CH4_TER by O1D }
LCH4_TERbySoil  = IGNORE;  { Tracks loss of CH4_TER by Soil }
CH4_RES     = IGNORE;  { Methane from RES emissions }
LCH4_RESbyOH    = IGNORE;  { Tracks loss of CH4_RES by OH }
LCH4_RESbyCl    = IGNORE;  { Tracks loss of CH4_RES by Cl }
LCH4_RESbyO1D   = IGNORE;  { Tracks loss of CH4_RES by O1D }
LCH4_RESbySoil  = IGNORE;  { Tracks loss of CH4_RES by Soil }


#DEFFIX
FixedOH       = IGNORE;  { Externally-supplied OH concentration     }
FixedCl       = IGNORE;  { Externally-supplied Cl concentration     }
FixedO1D      = IGNORE;  { Externally-supplied O(1D) concentration  }
DummyCH4      = IGNORE;  { Dummy placeholder for CH4   reactant     }
DummyNMVOC    = IGNORE;  { Dummy placeholder for NMVOC reactant     }
DummyCO       = IGNORE;  { Sink for carbon from tagged CH4 loss      }

#EQUATIONS
//
// The same prescribed-oxidant mechanism is used at every model level.
//
// Rate [1/s] is from JPL 1997
CH4 + FixedOH  = LCH4byOH            : 2.45d-12*EXP(-1775.0d0/TEMP);
//
// Rate [1/s] is from Kirschke et al, 2013 (Nature Geosci.)
CH4 + FixedCl  = LCH4byCl            : 9.60d-12*EXP(-1360.0d0/TEMP);
//
// Rate is identical to the corresponding reaction in fullchem.eqn.
CH4 + FixedO1D = LCH4byO1D           : 1.75d-10;

// Surface-only first-order soil uptake.  k_Oxidants(4) is diagnosed from the
// HEMCO MeMo uptake flux and the instantaneous surface-level CH4 mass.
CH4             = LCH4bySoil          : k_Oxidants(4);
//
// Rate k_Oxidants(1) is the HEMCO-supplied P(CO) from CH4.
DummyCH4      = CO    + PCOfromCH4   : k_Oxidants(1);
//
// Rate k_Oxidants(2) is the output of rate law function GC_OHCO.
CO  + FixedOH = LCObyOH              : k_Oxidants(2);
//
// DummyNMVOC is a placeholder species set to 1 molec/cm3.
// This is a KPP "trick" in order to set the final CO concentration
// to k_Oxidants(3) [molec/cm3/s] * dt [s], where dt is the chemistry
// timestep.  k_Oxidants(3) contains externally-supplied P(CO) from NMVOC.
DummyNMVOC    = CO    + PCOfromNMVOC : k_Oxidants(3);

// Sector-tagged methane uses the same four loss pathways as total CH4.
// DummyCO terminates tagged carbon until tagged CO chemistry is coupled.
CH4_OIL + FixedOH  = DummyCO + LCH4_OILbyOH   : 2.45d-12*EXP(-1775.0d0/TEMP);
CH4_OIL + FixedCl  = DummyCO + LCH4_OILbyCl   : 9.60d-12*EXP(-1360.0d0/TEMP);
CH4_OIL + FixedO1D = DummyCO + LCH4_OILbyO1D  : 1.75d-10;
CH4_OIL            = DummyCO + LCH4_OILbySoil : k_Oxidants(4);
CH4_GAS + FixedOH  = DummyCO + LCH4_GASbyOH   : 2.45d-12*EXP(-1775.0d0/TEMP);
CH4_GAS + FixedCl  = DummyCO + LCH4_GASbyCl   : 9.60d-12*EXP(-1360.0d0/TEMP);
CH4_GAS + FixedO1D = DummyCO + LCH4_GASbyO1D  : 1.75d-10;
CH4_GAS            = DummyCO + LCH4_GASbySoil : k_Oxidants(4);
CH4_COL + FixedOH  = DummyCO + LCH4_COLbyOH   : 2.45d-12*EXP(-1775.0d0/TEMP);
CH4_COL + FixedCl  = DummyCO + LCH4_COLbyCl   : 9.60d-12*EXP(-1360.0d0/TEMP);
CH4_COL + FixedO1D = DummyCO + LCH4_COLbyO1D  : 1.75d-10;
CH4_COL            = DummyCO + LCH4_COLbySoil : k_Oxidants(4);
CH4_LIV + FixedOH  = DummyCO + LCH4_LIVbyOH   : 2.45d-12*EXP(-1775.0d0/TEMP);
CH4_LIV + FixedCl  = DummyCO + LCH4_LIVbyCl   : 9.60d-12*EXP(-1360.0d0/TEMP);
CH4_LIV + FixedO1D = DummyCO + LCH4_LIVbyO1D  : 1.75d-10;
CH4_LIV            = DummyCO + LCH4_LIVbySoil : k_Oxidants(4);
CH4_LDF + FixedOH  = DummyCO + LCH4_LDFbyOH   : 2.45d-12*EXP(-1775.0d0/TEMP);
CH4_LDF + FixedCl  = DummyCO + LCH4_LDFbyCl   : 9.60d-12*EXP(-1360.0d0/TEMP);
CH4_LDF + FixedO1D = DummyCO + LCH4_LDFbyO1D  : 1.75d-10;
CH4_LDF            = DummyCO + LCH4_LDFbySoil : k_Oxidants(4);
CH4_WST + FixedOH  = DummyCO + LCH4_WSTbyOH   : 2.45d-12*EXP(-1775.0d0/TEMP);
CH4_WST + FixedCl  = DummyCO + LCH4_WSTbyCl   : 9.60d-12*EXP(-1360.0d0/TEMP);
CH4_WST + FixedO1D = DummyCO + LCH4_WSTbyO1D  : 1.75d-10;
CH4_WST            = DummyCO + LCH4_WSTbySoil : k_Oxidants(4);
CH4_RIC + FixedOH  = DummyCO + LCH4_RICbyOH   : 2.45d-12*EXP(-1775.0d0/TEMP);
CH4_RIC + FixedCl  = DummyCO + LCH4_RICbyCl   : 9.60d-12*EXP(-1360.0d0/TEMP);
CH4_RIC + FixedO1D = DummyCO + LCH4_RICbyO1D  : 1.75d-10;
CH4_RIC            = DummyCO + LCH4_RICbySoil : k_Oxidants(4);
CH4_OTA + FixedOH  = DummyCO + LCH4_OTAbyOH   : 2.45d-12*EXP(-1775.0d0/TEMP);
CH4_OTA + FixedCl  = DummyCO + LCH4_OTAbyCl   : 9.60d-12*EXP(-1360.0d0/TEMP);
CH4_OTA + FixedO1D = DummyCO + LCH4_OTAbyO1D  : 1.75d-10;
CH4_OTA            = DummyCO + LCH4_OTAbySoil : k_Oxidants(4);
CH4_BBN + FixedOH  = DummyCO + LCH4_BBNbyOH   : 2.45d-12*EXP(-1775.0d0/TEMP);
CH4_BBN + FixedCl  = DummyCO + LCH4_BBNbyCl   : 9.60d-12*EXP(-1360.0d0/TEMP);
CH4_BBN + FixedO1D = DummyCO + LCH4_BBNbyO1D  : 1.75d-10;
CH4_BBN            = DummyCO + LCH4_BBNbySoil : k_Oxidants(4);
CH4_WTL + FixedOH  = DummyCO + LCH4_WTLbyOH   : 2.45d-12*EXP(-1775.0d0/TEMP);
CH4_WTL + FixedCl  = DummyCO + LCH4_WTLbyCl   : 9.60d-12*EXP(-1360.0d0/TEMP);
CH4_WTL + FixedO1D = DummyCO + LCH4_WTLbyO1D  : 1.75d-10;
CH4_WTL            = DummyCO + LCH4_WTLbySoil : k_Oxidants(4);
CH4_SEE + FixedOH  = DummyCO + LCH4_SEEbyOH   : 2.45d-12*EXP(-1775.0d0/TEMP);
CH4_SEE + FixedCl  = DummyCO + LCH4_SEEbyCl   : 9.60d-12*EXP(-1360.0d0/TEMP);
CH4_SEE + FixedO1D = DummyCO + LCH4_SEEbyO1D  : 1.75d-10;
CH4_SEE            = DummyCO + LCH4_SEEbySoil : k_Oxidants(4);
CH4_LAK + FixedOH  = DummyCO + LCH4_LAKbyOH   : 2.45d-12*EXP(-1775.0d0/TEMP);
CH4_LAK + FixedCl  = DummyCO + LCH4_LAKbyCl   : 9.60d-12*EXP(-1360.0d0/TEMP);
CH4_LAK + FixedO1D = DummyCO + LCH4_LAKbyO1D  : 1.75d-10;
CH4_LAK            = DummyCO + LCH4_LAKbySoil : k_Oxidants(4);
CH4_TER + FixedOH  = DummyCO + LCH4_TERbyOH   : 2.45d-12*EXP(-1775.0d0/TEMP);
CH4_TER + FixedCl  = DummyCO + LCH4_TERbyCl   : 9.60d-12*EXP(-1360.0d0/TEMP);
CH4_TER + FixedO1D = DummyCO + LCH4_TERbyO1D  : 1.75d-10;
CH4_TER            = DummyCO + LCH4_TERbySoil : k_Oxidants(4);
CH4_RES + FixedOH  = DummyCO + LCH4_RESbyOH   : 2.45d-12*EXP(-1775.0d0/TEMP);
CH4_RES + FixedCl  = DummyCO + LCH4_RESbyCl   : 9.60d-12*EXP(-1360.0d0/TEMP);
CH4_RES + FixedO1D = DummyCO + LCH4_RESbyO1D  : 1.75d-10;
CH4_RES            = DummyCO + LCH4_RESbySoil : k_Oxidants(4);
