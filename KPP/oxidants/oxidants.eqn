#DEFFIX
FixedOH       = IGNORE;  { Externally-supplied OH concentration     }
FixedCl       = IGNORE;  { Externally-supplied Cl concentration     }
FixedO1D      = IGNORE;  { Externally-supplied O(1D) concentration  }
DummyCH4      = IGNORE;  { Dummy placeholder for CH4   reactant     }
DummyNMVOC    = IGNORE;  { Dummy placeholder for NMVOC reactant     }
DummyCO       = IGNORE;  { Sink for carbon from tagged CH4 loss      }

#EQUATIONS
//
// The same prescribed-oxidant mechanism is used at every model level.
//
// Rate [1/s] is from JPL 1997
CH4 + FixedOH  = LCH4byOH            : 2.45d-12*EXP(-1775.0d0/TEMP);
//
// Rate [1/s] is from Kirschke et al, 2013 (Nature Geosci.)
CH4 + FixedCl  = LCH4byCl            : 9.60d-12*EXP(-1360.0d0/TEMP);
//
// Rate is identical to the corresponding reaction in fullchem.eqn.
CH4 + FixedO1D = LCH4byO1D           : 1.75d-10;

// Surface-only first-order soil uptake.  k_Oxidants(4) is diagnosed from the
// HEMCO MeMo uptake flux and the instantaneous surface-level CH4 mass.
CH4             = LCH4bySoil          : k_Oxidants(4);
//
// Rate k_Oxidants(1) is the HEMCO-supplied P(CO) from CH4.
DummyCH4      = CO    + PCOfromCH4   : k_Oxidants(1);
//
// Rate k_Oxidants(2) is the output of rate law function GC_OHCO.
CO  + FixedOH = LCObyOH              : k_Oxidants(2);
//
// DummyNMVOC is a placeholder species set to 1 molec/cm3.
// This is a KPP "trick" in order to set the final CO concentration
// to k_Oxidants(3) [molec/cm3/s] * dt [s], where dt is the chemistry
// timestep.  k_Oxidants(3) contains externally-supplied P(CO) from NMVOC.
DummyNMVOC    = CO    + PCOfromNMVOC : k_Oxidants(3);

// Sector-tagged methane uses the same four loss pathways as total CH4.
// DummyCO terminates tagged carbon until tagged CO chemistry is coupled.
CH4_OIL + FixedOH  = DummyCO + LCH4_OILbyOH   : 2.45d-12*EXP(-1775.0d0/TEMP);
CH4_OIL + FixedCl  = DummyCO + LCH4_OILbyCl   : 9.60d-12*EXP(-1360.0d0/TEMP);
CH4_OIL + FixedO1D = DummyCO + LCH4_OILbyO1D  : 1.75d-10;
CH4_OIL            = DummyCO + LCH4_OILbySoil : k_Oxidants(4);
CH4_GAS + FixedOH  = DummyCO + LCH4_GASbyOH   : 2.45d-12*EXP(-1775.0d0/TEMP);
CH4_GAS + FixedCl  = DummyCO + LCH4_GASbyCl   : 9.60d-12*EXP(-1360.0d0/TEMP);
CH4_GAS + FixedO1D = DummyCO + LCH4_GASbyO1D  : 1.75d-10;
CH4_GAS            = DummyCO + LCH4_GASbySoil : k_Oxidants(4);
CH4_COL + FixedOH  = DummyCO + LCH4_COLbyOH   : 2.45d-12*EXP(-1775.0d0/TEMP);
CH4_COL + FixedCl  = DummyCO + LCH4_COLbyCl   : 9.60d-12*EXP(-1360.0d0/TEMP);
CH4_COL + FixedO1D = DummyCO + LCH4_COLbyO1D  : 1.75d-10;
CH4_COL            = DummyCO + LCH4_COLbySoil : k_Oxidants(4);
CH4_LIV + FixedOH  = DummyCO + LCH4_LIVbyOH   : 2.45d-12*EXP(-1775.0d0/TEMP);
CH4_LIV + FixedCl  = DummyCO + LCH4_LIVbyCl   : 9.60d-12*EXP(-1360.0d0/TEMP);
CH4_LIV + FixedO1D = DummyCO + LCH4_LIVbyO1D  : 1.75d-10;
CH4_LIV            = DummyCO + LCH4_LIVbySoil : k_Oxidants(4);
CH4_LDF + FixedOH  = DummyCO + LCH4_LDFbyOH   : 2.45d-12*EXP(-1775.0d0/TEMP);
CH4_LDF + FixedCl  = DummyCO + LCH4_LDFbyCl   : 9.60d-12*EXP(-1360.0d0/TEMP);
CH4_LDF + FixedO1D = DummyCO + LCH4_LDFbyO1D  : 1.75d-10;
CH4_LDF            = DummyCO + LCH4_LDFbySoil : k_Oxidants(4);
CH4_WST + FixedOH  = DummyCO + LCH4_WSTbyOH   : 2.45d-12*EXP(-1775.0d0/TEMP);
CH4_WST + FixedCl  = DummyCO + LCH4_WSTbyCl   : 9.60d-12*EXP(-1360.0d0/TEMP);
CH4_WST + FixedO1D = DummyCO + LCH4_WSTbyO1D  : 1.75d-10;
CH4_WST            = DummyCO + LCH4_WSTbySoil : k_Oxidants(4);
CH4_RIC + FixedOH  = DummyCO + LCH4_RICbyOH   : 2.45d-12*EXP(-1775.0d0/TEMP);
CH4_RIC + FixedCl  = DummyCO + LCH4_RICbyCl   : 9.60d-12*EXP(-1360.0d0/TEMP);
CH4_RIC + FixedO1D = DummyCO + LCH4_RICbyO1D  : 1.75d-10;
CH4_RIC            = DummyCO + LCH4_RICbySoil : k_Oxidants(4);
CH4_OTA + FixedOH  = DummyCO + LCH4_OTAbyOH   : 2.45d-12*EXP(-1775.0d0/TEMP);
CH4_OTA + FixedCl  = DummyCO + LCH4_OTAbyCl   : 9.60d-12*EXP(-1360.0d0/TEMP);
CH4_OTA + FixedO1D = DummyCO + LCH4_OTAbyO1D  : 1.75d-10;
CH4_OTA            = DummyCO + LCH4_OTAbySoil : k_Oxidants(4);
CH4_BBN + FixedOH  = DummyCO + LCH4_BBNbyOH   : 2.45d-12*EXP(-1775.0d0/TEMP);
CH4_BBN + FixedCl  = DummyCO + LCH4_BBNbyCl   : 9.60d-12*EXP(-1360.0d0/TEMP);
CH4_BBN + FixedO1D = DummyCO + LCH4_BBNbyO1D  : 1.75d-10;
